# ---------- Banco de dados (SQL Server) ----------
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=meu-servidor.database.windows.net
DB_DATABASE=RH
DB_USERNAME=usuario_leitura
DB_PASSWORD=troque-esta-senha

# Nomes das tabelas (ajuste se necessário)
DB_TABELA_PONTO=marcacao_ponto
DB_TABELA_FUNCIONARIOS=funcionarios

# ---------- E-mail (SMTP) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=rpa@suaempresa.com
SMTP_PASSWORD=troque-esta-senha
SMTP_USE_TLS=true
SMTP_REMETENTE=rpa@suaempresa.com
# Vários destinatários separados por vírgula
SMTP_DESTINATARIOS=gestor1@suaempresa.com,rh@suaempresa.com

# ---------- Regras de negócio ----------
# Tolerância em minutos antes de considerar atraso / saída antecipada
TOLERANCIA_ATRASO_MIN=10
TOLERANCIA_SAIDA_MIN=10
# Quantos dias corridos o relatório deve cobrir (1 = só o dia anterior)
PERIODO_DIAS=1

TITULO_RELATORIO=Relatório Diário de Absenteísmo
